# =========================================
# Configurações do Servidor
# =========================================
# O Render define a porta automaticamente pela variável PORT
server.port=${PORT:8080}
server.servlet.context-path=/

# =========================================
# Codificação
# =========================================
spring.web.encoding.enabled=true
spring.web.encoding.charset=UTF-8
spring.web.encoding.force=true

# =========================================
# MySQL Database Configuration (Dinâmico)
# =========================================
# Se as variáveis de ambiente existirem (no Render/Railway), ele as usa. 
# Caso contrário, tenta o localhost (seu PC).
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/epidemia?useSSL=false&serverTimezone=America/Sao_Paulo}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:root}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# =========================================
# JPA / Hibernate Configuration
# =========================================
# 'update' cria as tabelas automaticamente se elas não existirem
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# =========================================
# Logging & JSON
# =========================================
logging.level.root=INFO
spring.jackson.time-zone=America/Sao_Paulo
spring.jackson.serialization.indent-output=true